<Window x:Class="ArenaGlass.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArenaGlass - MTG Arena Deck Tracker" 
        Height="600" Width="500" 
        MinHeight="400" MinWidth="350"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2d2d2d" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="ArenaGlass MVP" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="MTG Arena Deck Tracker" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
            </StackPanel>
        </Border>

        <!-- Game Status -->
        <Border Grid.Row="1" Background="#2d2d2d" Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding GameStatus}" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Monitoring: "/>
                    <TextBlock x:Name="MonitoringStatus" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Library Stats -->
        <Border Grid.Row="2" Background="#2d2d2d" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Cards" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding TotalCards}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Unique Cards" FontSize="12" Opacity="0.7"/>
                    <TextBlock Text="{Binding UniqueCards}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Card List -->
        <Border Grid.Row="3" Background="#2d2d2d" Padding="5" Margin="0,0,0,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Remaining Cards in Library" FontWeight="Bold" Margin="5,5,5,10"/>
                <ListBox ItemsSource="{Binding RemainingCards}" 
                         DisplayMemberPath="Display"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>

        <!-- Controls -->
        <Border Grid.Row="4" Background="#2d2d2d" Padding="10">
            <StackPanel>
                <!-- Monitoring Controls -->
                <WrapPanel Margin="0,0,0,10">
                    <Button Content="Start Monitoring" 
                            Command="{Binding StartMonitoringCommand}"/>
                    <Button Content="Stop Monitoring" 
                            Command="{Binding StopMonitoringCommand}"/>
                    <Button Content="Load Demo" 
                            Command="{Binding LoadDemoCommand}"/>
                    <Button Content="Clear Deck" 
                            Command="{Binding ClearDeckCommand}"/>
                </WrapPanel>

                <!-- Simulation Controls -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <TextBlock Text="Simulate Draw:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SimulationCardName, UpdateSourceTrigger=PropertyChanged}" 
                             Width="150" Margin="0,0,10,0" Padding="5"/>
                    <Button Content="Draw Card" 
                            Command="{Binding SimulateDrawCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <Window.Resources>
        <!-- Simple resources -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
</Window>